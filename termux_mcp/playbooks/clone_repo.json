{
  "schema": 1,
  "id": "clone_repo",
  "title": "Clone a git repository",
  "category": "git",
  "risk": "write",
  "phrases": ["clone {repo}", "git clone {repo}", "clone the repo {repo}", "download the repo {repo}"],
  "match": {
    "repo": {"type": "repo", "required": true},
    "dir": {"type": "path", "default": "~"},
    "name": {"type": "name", "from": "repo", "op": "basename"}
  },
  "requires": [{"check": "git_present"}],
  "steps": [
    {"run": "test -d {dir}/{name} || git clone https://github.com/{repo}.git {dir}/{name}",
     "verify": "test -d {dir}/{name}/.git"}
  ],
  "success": "Cloned {repo} into {dir}/{name}."
}
